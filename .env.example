# Contact form delivery (https://resend.com). Without a key the form reports
# "Email is not configured" and nothing is sent.
RESEND_API_KEY=
CONTACT_TO_EMAIL=danizein@furrsati.com
# Must be a sender on a domain verified in Resend.
CONTACT_FROM_EMAIL="Dani Zein <hello@furrsati.com>"

# Public URL used for metadata, sitemap and social cards.
NEXT_PUBLIC_SITE_URL=https://example.com
